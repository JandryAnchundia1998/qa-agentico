# ==============================================================
# Datos propios de este TICKET (funcional, sprint o historias de usuario).
# Todo lo demás se toma del .env del proyecto. Un valor vacío no reemplaza nada.
# Revisión: npm run verificar -- <proyecto>/<ticket> (no muestra las claves)
# ==============================================================

# Sistema que prueba este ticket: nombre de su carpeta en sistemas/ (ej.: easycore)
SISTEMA=

# Otros sistemas que intervienen (integraciones), separados por coma (ej.: siaerp)
OTROS_SISTEMAS=

# Código o nombre del funcional (ticket) en Arpsis (ej.: FN0002-3)
FUNCIONAL_ARPSIS=

# Solo si difieren de los del proyecto:
DESARROLLADOR=
AMBIENTE=
# URL=
# USUARIO_<ROL>=
# CLAVE_<ROL>=
# PARALELO=
