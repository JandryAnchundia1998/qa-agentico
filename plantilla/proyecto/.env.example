# ==============================================================
# Datos del PROYECTO: los comparten todos sus tickets.
# Complétalos tú: nunca los escribas en el chat.
# Lo que cambie en un ticket va en el .env de ese ticket.
# Revisión: npm run verificar -- <proyecto> (no muestra las claves)
# ==============================================================

# Sistema principal que se prueba (el SISTEMA de los tickets): URL de su página de inicio o de inicio de sesión
URL=

# Usuarios por rol del sistema principal: un par USUARIO_<ROL> / CLAVE_<ROL> por cada rol.
# Rol en mayúsculas y sin espacios (ej.: ADMIN, OPERADOR, CONSULTA).
USUARIO_ADMIN=
CLAVE_ADMIN=

# Otros sistemas que intervienen en las pruebas (integraciones): con el nombre de su carpeta en sistemas/.
# URL_<SISTEMA>=
# USUARIO_<SISTEMA>_<ROL>=
# CLAVE_<SISTEMA>_<ROL>=

# Ambiente de pruebas, como se llama en Arpsis:
# Desarrollo | Calidad | Preproducción | Producción
AMBIENTE=Calidad

# Desarrollador al que se asignan los bugs (nombre como aparece en Arpsis).
# Si cambia por ticket, déjalo vacío aquí y escríbelo en el .env de cada ticket.
DESARROLLADOR=

# Pruebas automatizadas que corren a la vez (1 por defecto = en serie).
# Súbelo (ej.: 3) solo si el ambiente lo soporta sin esperas agotadas ni intermitencias.
# PARALELO=1
