{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@soporte/*": ["soporte/*"],
      "@sistemas/*": ["sistemas/*"]
    }
  },
  "include": ["soporte/**/*.ts", "sistemas/**/*.ts", "proyectos/**/*.ts", "playwright.config.ts"]
}
